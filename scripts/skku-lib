#!/usr/bin/env python3
"""Agent CLI for the SKKU library, using the current Ego Lite profile."""
from concurrent.futures import ThreadPoolExecutor
import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path


def run_ego(program):
    result = subprocess.run(['ego-browser', 'nodejs'], input=program, text=True, capture_output=True, timeout=180)
    for line in reversed((result.stdout + '\n' + result.stderr).splitlines()):
        if line.startswith('SKKU_RESULT '):
            return json.loads(line.removeprefix('SKKU_RESULT '))
    return {'status':'error', 'code':'ego_unavailable', 'message':'Ego Lite 未返回结果。请查看浏览器是否在等待操作。'}


def browser(args):
    if not shutil.which('ego-browser'):
        return {'status':'error','code':'ego_missing','message':'找不到 ego-browser。'}
    script = Path(__file__).resolve().with_name('library.mjs').read_text()
    providers = Path(__file__).resolve().with_name('providers.mjs').read_text()
    result = run_ego('const args = '+json.dumps(args, ensure_ascii=True)+';\n'+providers+'\n'+script)
    space = result.pop('_finish', None)
    if space is not None:
        cleanup = run_ego(f'const t = await taskSpace({int(space)}); await t.finish({{keep:[]}}); console.log(\'SKKU_RESULT {{"ok":true}}\');')
        if not cleanup.get('ok'):
            result['cleanup_pending_space'] = space
    return result


def main():
    parser = argparse.ArgumentParser(description='用 Ego Lite 的学校登录态搜索 SKKU、下载论文 PDF。命令返回 JSON。')
    cmds = parser.add_subparsers(dest='action', required=True)
    search = cmds.add_parser('search')
    search.add_argument('--kind', choices=['papers','books','journals'], default='papers')
    search.add_argument('--collection', type=int, choices=[1,5,6,7,47,128], default=1)
    search.add_argument('--source',choices=['skku','arxiv','pubmed','crossref','all'],default='skku')
    search.add_argument('--member',type=int,help='限定 Crossref 出版机构编号')
    members = cmds.add_parser('publishers',help='按名称查 Crossref 出版机构编号')
    members.add_argument('query')
    members.add_argument('--limit',default=5,type=int)
    sources = cmds.add_parser('sources', help='实时查询两校区的数据库目录')
    sources.add_argument('query', nargs='?', default='')
    visit = cmds.add_parser('open-source', help='通过校方的数据库入口打开网站')
    browse = cmds.add_parser('site-search', help='在选定数据库的站内搜索框检索')
    take = cmds.add_parser('site-download', help='按站内检索结果下载 PDF')
    for cmd in [visit,browse,take]:
        cmd.add_argument('site', help='sources 返回的校区和数据库 ID，如 1:2750')
    for cmd in [browse,take]:
        cmd.add_argument('query')
        cmd.add_argument('--limit', default=10,type=int)
    take.add_argument('--id',required=True)
    take.add_argument('--out',required=True,type=Path)
    download = cmds.add_parser('download')
    download.add_argument('--id', required=True, help='搜索返回的论文记录 ID')
    download.add_argument('--out', required=True, type=Path)
    search.add_argument('query')
    download.add_argument('query',nargs='?',default='',help='SKKU 检索词。arxiv、pubmed 和 doi 标识符无需检索词。')
    for cmd in [search,download]:
        cmd.add_argument('--page', default=1, type=int)
        cmd.add_argument('--limit', default=5, type=int)
    for cmd in [search,download,sources,visit,browse,take]:
        cmd.add_argument('--space', type=int, help='继续本任务已有的 Ego Lite 空间')
    args = vars(parser.parse_args())
    global_id = args['action']=='download' and args['id'].startswith(('arxiv:','pubmed:','doi:'))
    if (args['action'] not in ('sources','open-source') and not global_id and not args['query'].strip()) or min(args.get('page',1),args.get('limit',1)) < 1:
        parser.error('请输入关键词、正整数页码和条数')
    if 'out' in args:
        dest = args['out'].expanduser().absolute()
        if dest.exists():
            return {'status':'error','code':'file_exists','path':str(dest)}
        args['out'] = str(dest)
    # The installed executable may be a symlink outside the skill folder.
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    if args['action']=='publishers':
        import direct
        return direct.members(args['query'],args['limit'])
    if args.get('member') is not None and (args.get('source')!='crossref' or args['member']<1):
        parser.error('--member 需配合 --source crossref 和正整数编号')
    if args.get('source','skku') != 'skku':
        if args['kind'] != 'papers':
            parser.error('指定公开论文 API 时请使用 --kind papers')
        import direct
        if args['source']=='all':
            sources=['skku','crossref','pubmed','arxiv']
            with ThreadPoolExecutor(max_workers=len(sources)) as pool:
                futures={name:pool.submit(browser if name=='skku' else direct.search,dict(args,source=name))
                         for name in sources}
                results={}
                for name,future in futures.items():
                    try:
                        results[name]=future.result()
                    except (OSError,subprocess.SubprocessError,ValueError):
                        results[name]={'status':'error','code':'source_unavailable'}
            successful=sum(r.get('status')=='ok' for r in results.values())
            return dict(status='ok' if successful else 'error',complete=successful==len(sources),
                        query=args['query'],results=results)
        return direct.search(args)
    if args['action']=='download' and args['id'].startswith('arxiv:'):
        import direct
        return direct.download_arxiv(args)
    return browser(args)


if __name__ == '__main__':
    try:
        result = main()
    except (OSError, subprocess.TimeoutExpired, ValueError) as err:
        result = {'status':'error','code':'runtime_error','message':type(err).__name__}
    print(json.dumps(result,ensure_ascii=False))
    sys.exit(0 if result.get('status') == 'ok' else 1)
